# El agente. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Envío por WhatsApp. https://console.twilio.com
# El sandbox se activa en minutos: el destinatario manda "join <código>" al número.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Guardarraíl del agente: todo envío que decide el agente sale SOLO hacia este
# número (unido al sandbox). Sin él, los envíos del agente se simulan.
TWILIO_WHATSAPP_TEST=

# Opcionales.
# CHISPY_MODELO=claude-opus-5
# CHISPY_EFFORT=medium      Profundidad del agente: low | medium | high | xhigh | max
# CHISPY_RITMO_MS=40        Retardo entre clientes en la cascada, solo para el ojo humano
